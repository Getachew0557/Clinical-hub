# ═══════════════════════════════════════════════════════════════════════════════
# Biruh Tena Clinical Hub — Environment Variables Reference
# Copy this file to each service's .env and fill in the values.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Get from: Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-strong-64-char-secret-here
JWT_EXPIRES_IN=24h

# ─── Service Ports ────────────────────────────────────────────────────────────
AUTH_PORT=5001
PATIENT_PORT=5002
APPT_PORT=5003
DOCTOR_PORT=5010
PORT=10000          # Render assigns this to the api-gateway

# ─── Internal Service URLs (all on same Render instance → localhost) ──────────
AUTH_SERVICE_URL=http://localhost:5001/api/auth
PATIENT_SERVICE_URL=http://localhost:5002/api/patients
APPOINTMENT_SERVICE_URL=http://localhost:5003/api/appointments
NOTIFICATION_SERVICE_URL=http://localhost:5003/api/notifications
DOCTOR_SERVICE_URL=http://localhost:5010/api/doctors
BILLING_SERVICE_URL=http://localhost:5002/api/billing
EMR_SERVICE_URL=http://localhost:5002/api/emr
INVENTORY_SERVICE_URL=http://localhost:5010/api/inventory
REPORT_SERVICE_URL=http://localhost:5010/api/reports
AI_SERVICE_URL=http://localhost:5009/api/ai
INTERNAL_EVENT_SUBSCRIBERS=http://localhost:5002/api/internal/events,http://localhost:5003/api/internal/events

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized origins: https://bruhtena.vercel.app, http://localhost:5173
# Authorized redirect URIs: https://bruhtena.vercel.app, http://localhost:5173
GOOGLE_CLIENT_ID=450197875330-c89spigreijavanih44fjnea42qupfqs.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET is NOT needed — we use ID token verification only (no server-side OAuth flow)

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Option A — Gmail (recommended for production):
#   1. Enable 2FA on your Google account
#   2. Go to Google Account → Security → App Passwords → Generate
#   3. Use the 16-char app password as SMTP_PASS (NOT your Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password

# Option B — SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your-sendgrid-api-key

# Option C — Leave blank to use Ethereal (auto-created test account, dev only)
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=

# ─── Frontend URL (used in email links) ───────────────────────────────────────
FRONTEND_URL=https://bruhtena.vercel.app
# Local dev: FRONTEND_URL=http://localhost:5173

# ─── Supabase (for real-time notifications on frontend) ───────────────────────
# Get from: Supabase → Project Settings → API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ─── AI Service (Gemini) ──────────────────────────────────────────────────────
# Get from: Google AI Studio → API Keys
GEMINI_API_KEY=AIza...
MODEL_NAME=gemini-1.5-flash

# ─── Stripe (optional — for card payments) ────────────────────────────────────
# Get from: Stripe Dashboard → Developers → API Keys
# Leave blank to use the manual proof-of-payment workflow
STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...  (for webhook verification)

# ─── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
SEED_SECRET=clinical-hub-seed-2024

# ─── Render ───────────────────────────────────────────────────────────────────
RENDER_EXTERNAL_URL=https://clinical-hub.onrender.com
