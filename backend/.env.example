# ─── Database (Aiven MySQL) ───────────────────────────────────────────────────
DB_HOST=your-mysql-host.aivencloud.com
DB_USER=avnadmin
DB_PASS=your-password
DB_NAME=dental_clinic
DB_PORT=3306

# ─── RabbitMQ (CloudAMQP) ─────────────────────────────────────────────────────
RABBITMQ_URL=amqps://user:pass@host/vhost

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-strong-secret-here
JWT_EXPIRES_IN=24h

# ─── Service Ports ────────────────────────────────────────────────────────────
# When running all services on one Render instance, each needs a unique port
GATEWAY_PORT=5050
AUTH_PORT=5001
PATIENT_PORT=5002
APPOINTMENT_PORT=5003
EMR_PORT=5004
BILLING_PORT=5005
INVENTORY_PORT=5006
REPORT_PORT=5007
NOTIFICATION_PORT=5008
AI_PORT=5009
DOCTOR_PORT=5010

# ─── Internal Service URLs (same host, different ports) ───────────────────────
AUTH_SERVICE_URL=http://localhost:5001
PATIENT_SERVICE_URL=http://localhost:5002
APPOINTMENT_SERVICE_URL=http://localhost:5003
EMR_SERVICE_URL=http://localhost:5004
BILLING_SERVICE_URL=http://localhost:5005
INVENTORY_SERVICE_URL=http://localhost:5006
REPORT_SERVICE_URL=http://localhost:5007
NOTIFICATION_SERVICE_URL=http://localhost:5008
AI_SERVICE_URL=http://localhost:5009
DOCTOR_SERVICE_URL=http://localhost:5010

# ─── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
